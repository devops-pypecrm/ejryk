# Copy to .env.local (dev) or set on the server (production). Never commit real values.
AUTH_SECRET=        # random string, 32+ chars:  openssl rand -hex 32
ADMIN_USER=        # the login username
ADMIN_PASSWORD=     # a long, unique password
# DATA_DIR=/var/lib/zenitzu   # optional: where leads/tasks are stored (needs a persistent disk)

# --- AI: Claude is the only AI used (chatbot, Studio, lead drafts, automation) ---
ANTHROPIC_API_KEY= # Claude: key from console.anthropic.com
# CLAUDE_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 / claude-haiku-5-5 for lower cost

# --- Free marketing & automation (all optional) ---
# TELEGRAM_BOT_TOKEN=   # new-lead alerts: create a bot with @BotFather
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=  # or a Discord channel webhook
# NOTIFY_WEBHOOK_URL=   # or Zapier/Make/n8n: receives {"text": "..."}
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX      # Google Analytics 4 (free)
# NEXT_PUBLIC_CLARITY_ID=abcd1234     # Microsoft Clarity heatmaps (free)
# SITE_URL=https://zenitzu.com        # used by sitemap.xml and the SEO checker

# --- Automation scheduler ---
# Runs inside the Node server automatically (VPS/Docker). On serverless, set CRON_SECRET and have any
# free cron (cron-job.org, GitHub Actions) call: curl -X POST https://your-site/api/cron -H "Authorization: Bearer $CRON_SECRET"
# CRON_SECRET=          # 16+ random characters; leave unset to disable /api/cron
# AUTOMATION_SCHEDULER=off   # turn off the in-process scheduler
# TZ_NAME=Asia/Kolkata  # timezone for schedule hours

# --- Post automation: publish calendar items to YOUR accounts (all optional; a channel is live only when all its vars are set) ---
# X / Twitter (developer.x.com, free tier, OAuth 1.0a keys with Read+Write):
# X_API_KEY=  X_API_SECRET=  X_ACCESS_TOKEN=  X_ACCESS_SECRET=
# LinkedIn (w_member_social scope; token expires about every 60 days):
# LINKEDIN_ACCESS_TOKEN=  LINKEDIN_AUTHOR=urn:li:person:xxxx   (or urn:li:organization:xxxx)
# Facebook Page (long-lived Page access token):
# FACEBOOK_PAGE_ID=  FACEBOOK_PAGE_TOKEN=
# Telegram channel (add the bot as channel admin; this is separate from the private alert chat):
# TELEGRAM_CHANNEL_ID=@yourchannel
# Discord channel (a separate webhook from the alert one):
# DISCORD_POST_WEBHOOK_URL=
# Anything else (Instagram, Buffer, Google Business...) via a free Zapier/Make/n8n webhook that receives {channel,title,text}:
# PUBLISH_WEBHOOK_URL=
